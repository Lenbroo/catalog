<!doctype html>
<html lang="en" data-theme="dark" style="background:#16132A">
<head>
<meta charset="utf-8">
<meta name="color-scheme" content="dark">
<meta name="theme-color" content="#16132A">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Service Catalogue, Phase 2</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
:root{
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
  /* Klea brand palette */
  --purple:#A190F9; --dpurple:#554A93; --grey:#EEF1F4;
  --green:#B6DEA7; --yellow:#F5E3A3; --blue:#5A7DD6; --pink:#E0A1D7; --brown:#61433A;

  /* one fixed brand-dark theme for every browser */
  color-scheme:dark;
  --bg:#16132A; --surface:#211D3B; --ink:#EEF1F4; --ink-2:#C3BEE3; --ink-3:#8F89B8;
  --line:#332D57; --line-2:#29244A; --accent:#A190F9; --on-accent:#16132A;
  --hl:#7A6A2A; --focus:#A190F9; --shadow:0 1px 2px rgba(0,0,0,.3),0 10px 30px -14px rgba(0,0,0,.6);
  --mix:#211D3B; --tint-amt:30%;
  --font:"Figtree",ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
  --ease:cubic-bezier(.22,.8,.24,1);
}
*,*::before,*::after{box-sizing:inherit}
html,body{min-height:100%}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--font);font-size:15.5px;line-height:1.5;-webkit-font-smoothing:antialiased;overflow-x:hidden}
button,input{font:inherit;color:inherit}
:focus-visible{outline:2.5px solid var(--focus);outline-offset:3px}
mark{background:var(--hl);color:inherit;border-radius:3px;padding:0 2px}

/* ---------- top bar ---------- */
.top{position:sticky;top:0;z-index:30;background:color-mix(in srgb,var(--bg) 86%,transparent);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border-bottom:1px solid transparent;transition:border-color .3s}
.top.scrolled{border-bottom-color:var(--line)}
.top-in{max-width:1080px;margin:0 auto;padding:18px 24px;display:flex;gap:14px;align-items:center;flex-wrap:wrap}
.brand{display:flex;align-items:center;gap:16px;margin-right:auto;cursor:pointer;background:none;border:0;padding:0}
.logo{display:block;height:44px;width:auto;transition:transform .5s var(--ease)}
.brand:hover .logo{transform:scale(1.03)}
.brand-sep{width:1.5px;height:34px;background:var(--line);border-radius:1px;flex:none}
.brand-t{font-weight:700;font-size:16px;color:var(--ink);letter-spacing:-.01em;line-height:1.1;text-align:left}
.brand-t span{display:block;font-weight:500;font-size:13px;color:var(--ink-3);letter-spacing:0}
.search{position:relative;flex:1 1 320px;max-width:440px}
.search input{width:100%;height:46px;border:1.5px solid var(--line);background:var(--surface);border-radius:14px;padding:0 42px 0 44px;font-size:15px;transition:border-color .2s,box-shadow .25s}
.search input:focus{outline:none;border-color:var(--purple);box-shadow:0 0 0 4px color-mix(in srgb,var(--purple) 22%,transparent)}
.search svg{position:absolute;left:15px;top:14px;width:18px;height:18px;color:var(--ink-3)}
.search .clr{position:absolute;right:7px;top:7px;width:32px;height:32px;border:0;background:var(--line-2);border-radius:10px;cursor:pointer;color:var(--ink-2);font-size:18px;line-height:1;opacity:0;pointer-events:none;transform:scale(.8);transition:opacity .2s,transform .2s var(--ease)}
.search.has .clr{opacity:1;pointer-events:auto;transform:none}
.tabs{position:relative;display:flex;background:var(--surface);border:1.5px solid var(--line);border-radius:14px;padding:4px}
.tabs button{position:relative;z-index:1;border:0;background:none;padding:8px 14px;border-radius:10px;cursor:pointer;font-weight:700;font-size:14px;color:var(--ink-2);transition:color .3s}
.tabs button[aria-selected="true"]{color:var(--on-accent)}
.tabs .pill{position:absolute;z-index:0;top:4px;bottom:4px;left:0;width:0;border-radius:10px;background:var(--accent);transition:transform .45s var(--ease),width .45s var(--ease)}

/* ---------- stage ---------- */
.wrap{max-width:1080px;margin:0 auto;padding:10px 24px 90px}
.stage-head{display:flex;align-items:center;gap:16px;margin:18px 0 22px;min-height:52px}
.back{flex:none;padding:0;width:48px;height:48px;border-radius:50%;border:1.5px solid var(--line);background:var(--surface);display:grid;place-items:center;cursor:pointer;color:var(--ink);transition:transform .35s var(--ease),background .2s,border-color .2s,opacity .3s,width .35s var(--ease),margin .35s var(--ease)}
.back:hover{border-color:var(--purple);transform:translateX(-3px)}
.back svg{width:20px;height:20px}
.back.gone{opacity:0;width:0;margin-right:-16px;border-width:0;pointer-events:none;overflow:hidden}
.stage-title{min-width:0;flex:1}
.stage-title h1{margin:0;font-size:clamp(26px,4vw,40px);font-weight:800;letter-spacing:-.025em;line-height:1.08}
.stage-title p{margin:6px 0 0;color:var(--ink-2);font-size:15px}
.crumbs{display:flex;flex-wrap:wrap;gap:4px 6px;margin:6px 0 0;padding:0;list-style:none;font-size:14px;color:var(--ink-3)}
.crumbs a{color:var(--ink-2);text-decoration:none;font-weight:600;border-radius:6px}
.crumbs a:hover{color:var(--accent);text-decoration:underline}
.crumbs li+li::before{content:"/";margin-right:6px;color:var(--ink-3)}
.steps{display:flex;gap:6px;flex:none;align-self:center}
.steps i{width:8px;height:8px;border-radius:4px;background:var(--line);transition:width .5s var(--ease),background .4s}
.steps i.on{background:var(--purple)}
.steps i.cur{width:26px;background:var(--dpurple)}
.steps i.cur{background:var(--accent)}

#stage{position:relative}
.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}

/* ---------- tiles ---------- */
.tile{--tone:var(--purple);all:unset;box-sizing:border-box;position:relative;overflow:hidden;cursor:pointer;display:flex;flex-direction:column;min-height:170px;padding:24px 26px;border-radius:22px;background:var(--surface);border:1.5px solid var(--line);box-shadow:var(--shadow);transition:transform .45s var(--ease),box-shadow .45s var(--ease),border-color .3s}
.tile:hover{transform:translateY(-4px);border-color:color-mix(in srgb,var(--tone) 60%,var(--line));box-shadow:0 2px 4px rgba(85,74,147,.06),0 22px 40px -18px color-mix(in srgb,var(--tone) 70%,transparent)}
.tile:active{transform:translateY(-1px) scale(.985)}
.tile:focus-visible{outline:2.5px solid var(--focus);outline-offset:3px}
.tile .blob{position:absolute;right:-60px;top:-60px;width:190px;height:190px;border-radius:50%;background:var(--tone);opacity:.28;transition:transform .7s var(--ease),opacity .5s}
.tile:hover .blob{transform:scale(1.25) translate(-10px,10px);opacity:.4}
.tile.big{min-height:230px;background:color-mix(in srgb,var(--tone) var(--tint-amt),var(--mix));border-color:transparent}
.tile.big .blob{opacity:.55;width:240px;height:240px;right:-70px;top:-80px}
.tile.big:hover .blob{opacity:.75}
.t-num{position:relative;font-size:44px;font-weight:800;letter-spacing:-.04em;line-height:1;color:var(--ink)}
.t-num small{font-size:15px;font-weight:600;letter-spacing:0;color:var(--ink-2);margin-left:6px}
.t-body{position:relative;margin-top:auto;padding-top:26px;padding-right:44px}
.t-name{display:block;font-size:22px;font-weight:800;letter-spacing:-.015em;line-height:1.2}
.tile:not(.big) .t-name{font-size:19px}
.t-desc{display:block;margin-top:6px;font-size:14px;color:var(--ink-2);line-height:1.45;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.t-go{position:absolute;right:22px;bottom:22px;width:40px;height:40px;border-radius:50%;background:var(--surface);display:grid;place-items:center;color:var(--ink);transition:transform .45s var(--ease),background .3s,color .3s;box-shadow:0 2px 8px -2px rgba(85,74,147,.25)}
.tile:not(.big) .t-go{background:var(--line-2);box-shadow:none}
.tile:hover .t-go{transform:translateX(4px);background:var(--dpurple);color:#fff}
.t-go svg{width:18px;height:18px}
.t-meta{position:relative;display:flex;flex-wrap:wrap;gap:6px;margin-top:12px}
.pill-s{font-size:12.5px;font-weight:700;padding:3px 10px;border-radius:999px;background:color-mix(in srgb,var(--tone) 30%,var(--mix));color:var(--ink)}
.t-match{position:relative;display:block;margin-top:10px;font-size:13.5px;color:var(--ink-2)}

/* ---------- motion: step transitions ---------- */
.anim-in{animation:tileIn .6s var(--ease) both;animation-delay:calc(var(--i,0) * 55ms)}
.dir-back .anim-in{animation-name:tileInBack}
@keyframes tileIn{from{opacity:0;transform:translate(34px,18px) scale(.97)}to{opacity:1;transform:none}}
@keyframes tileInBack{from{opacity:0;transform:translate(-34px,18px) scale(.97)}to{opacity:1;transform:none}}
#stage.leaving .anim-out{animation:tileOut .32s var(--ease) both;animation-delay:calc(min(var(--i,0),8) * 22ms)}
#stage.leaving.dir-back .anim-out{animation-name:tileOutBack}
#stage.leaving .chosen{animation:chosen .42s var(--ease) both!important;z-index:2}
@keyframes tileOut{to{opacity:0;transform:translate(-26px,8px) scale(.96)}}
@keyframes tileOutBack{to{opacity:0;transform:translate(26px,8px) scale(.96)}}
@keyframes chosen{0%{transform:scale(1)}35%{transform:scale(1.03);box-shadow:0 30px 60px -24px color-mix(in srgb,var(--tone) 90%,transparent)}100%{opacity:0;transform:scale(1.08)}}
.head-anim{animation:headIn .55s var(--ease) both}
@keyframes headIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
.stage-head.leaving .stage-title{animation:headOut .28s var(--ease) both}
@keyframes headOut{to{opacity:0;transform:translateY(-8px)}}

/* ---------- detail ---------- */
.hero{--tone:var(--purple);position:relative;overflow:hidden;border-radius:26px;padding:30px 30px 26px;background:color-mix(in srgb,var(--tone) var(--tint-amt),var(--mix))}
.hero .blob{position:absolute;right:-90px;top:-110px;width:320px;height:320px;border-radius:50%;background:var(--tone);opacity:.55;animation:float 9s ease-in-out infinite}
.hero .blob.b2{right:auto;left:-120px;top:auto;bottom:-170px;width:280px;height:280px;opacity:.25;animation-delay:-4s}
@keyframes float{50%{transform:translate(-18px,14px) scale(1.06)}}
.stats{position:relative;display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:14px}
.stat{background:color-mix(in srgb,var(--surface) 78%,transparent);backdrop-filter:blur(6px);border-radius:16px;padding:16px 18px}
.stat b{display:block;font-size:30px;font-weight:800;letter-spacing:-.03em;line-height:1.05}
.stat span{display:block;margin-top:4px;font-size:13.5px;color:var(--ink-2);font-weight:600}
.hero-panels{position:relative;margin-top:16px;display:flex;flex-wrap:wrap;gap:8px}
.hero-panels .pill-s{background:var(--surface)}
.sec{margin-top:34px}
.hint{margin:-6px 0 14px;color:var(--ink-2);font-size:14.5px}
.sec>h2{margin:0 0 14px;font-size:22px;font-weight:800;letter-spacing:-.015em}
.comp-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
.comp{background:var(--surface);border:1.5px solid var(--line);border-radius:18px;padding:18px 20px}
.comp h3{margin:0 0 10px;font-size:16px;font-weight:800;display:flex;align-items:center;gap:10px}
.comp h3 .dot{width:10px;height:10px;border-radius:50%;background:var(--tone,var(--purple))}
.chips{display:flex;flex-wrap:wrap;gap:6px}
.chip{background:var(--line-2);border-radius:9px;padding:5px 11px;font-size:14px;font-weight:500}
.panel{--tone:var(--purple);background:var(--surface);border:1.5px solid var(--line);border-radius:20px;margin-bottom:14px;overflow:hidden;transition:border-color .3s,box-shadow .4s var(--ease)}
.panel.open{box-shadow:var(--shadow)}
.panel-h{all:unset;box-sizing:border-box;cursor:pointer;width:100%;display:flex;align-items:center;gap:14px;padding:18px 20px}
.panel-h:focus-visible{outline:2.5px solid var(--focus);outline-offset:-3px;border-radius:20px}
.panel-h .sw{width:14px;height:38px;border-radius:7px;background:var(--tone);flex:none}
.panel-h .nm{font-size:19px;font-weight:800;letter-spacing:-.01em;flex:1;min-width:0}
.panel-h .nm small{display:block;font-size:13.5px;font-weight:600;color:var(--ink-2);letter-spacing:0;margin-top:2px}
.panel-h .ct{font-size:28px;font-weight:800;letter-spacing:-.03em}
.panel-h .chev{width:34px;height:34px;border-radius:50%;background:var(--line-2);display:grid;place-items:center;transition:transform .45s var(--ease),background .3s;flex:none}
.panel.open .panel-h .chev{transform:rotate(180deg);background:var(--purple);color:#fff}
.panel-h .chev svg{width:16px;height:16px}
.reveal{display:grid;grid-template-rows:0fr;transition:grid-template-rows .5s var(--ease)}
.panel.open .reveal{grid-template-rows:1fr}
.reveal>div{overflow:hidden;min-height:0}
.p-body{padding:4px 20px 22px}
.grp{margin-top:18px}
.kind+.kind{margin-top:30px;padding-top:22px;border-top:1.5px solid var(--line)}
.kind>h3{margin:6px 0 0;font-size:18px;font-weight:800;display:flex;gap:8px;align-items:baseline}
.kind>h3 span{font-size:14px;font-weight:600;color:var(--ink-3)}
.grp h4{margin:0 0 6px;font-size:15.5px;font-weight:800;display:flex;gap:8px;align-items:baseline}
.grp h4 span{font-weight:600;color:var(--ink-3);font-size:13.5px}
ul.tests{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 26px}
ul.tests.al{grid-template-columns:repeat(3,minmax(0,1fr))}
ul.tests li{display:flex;justify-content:space-between;align-items:baseline;gap:8px;padding:7px 0;border-bottom:1px dashed var(--line);font-size:14.5px}
.panel.open ul.tests.al{grid-template-columns:repeat(3,minmax(0,1fr))}
ul.tests li{animation:rowIn .45s var(--ease) both;animation-delay:calc(min(var(--r,0),24) * 14ms + 120ms)}
@keyframes rowIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
ul.tests li.hit{background:color-mix(in srgb,var(--yellow) 55%,transparent);border-radius:8px;padding-left:8px;padding-right:8px}
.fl{display:flex;gap:4px;flex:none}
.f{font-size:11px;font-weight:800;padding:1px 6px;border-radius:6px;line-height:16px}
.f.calc{background:color-mix(in srgb,var(--blue) 18%,var(--mix));color:var(--blue)}
.note{margin-top:14px;padding:14px 18px;border-radius:14px;background:color-mix(in srgb,var(--yellow) 45%,var(--mix));font-size:14.5px;color:var(--ink)}
.legend{display:flex;flex-wrap:wrap;gap:8px 18px;font-size:13.5px;color:var(--ink-2);margin-top:18px}
.legend span{display:flex;gap:6px;align-items:center}
.used{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px;position:relative}
.linkchip{all:unset;cursor:pointer;background:var(--surface);border-radius:999px;padding:6px 14px;font-size:14px;font-weight:700;transition:background .25s,color .25s,transform .3s var(--ease)}
.linkchip:hover{background:var(--dpurple);color:#fff;transform:translateY(-2px)}
.linkchip:focus-visible{outline:2.5px solid var(--focus);outline-offset:2px}
.hlbar{display:flex;align-items:center;gap:10px;margin:0 0 16px;padding:10px 12px 10px 16px;border-radius:14px;background:color-mix(in srgb,var(--yellow) 60%,var(--mix));font-size:14.5px}
.hlbar button{margin-left:auto;border:0;background:var(--surface);border-radius:10px;padding:6px 12px;font-weight:700;cursor:pointer}

/* ---------- cross links ---------- */
.mlink{color:inherit;text-decoration:none;border-radius:4px;background-image:linear-gradient(var(--purple),var(--purple));background-size:0 1.5px;background-repeat:no-repeat;background-position:0 100%;transition:background-size .35s var(--ease),color .2s}
.mlink:hover{background-size:100% 1.5px;color:var(--accent)}
ul.tests li{transition:background .2s}
ul.tests li:hover{background:var(--line-2)}
.mgo{display:inline-grid;place-items:center;width:18px;opacity:0;transform:translateX(-4px);transition:opacity .25s,transform .3s var(--ease);color:var(--accent)}
.mgo svg{width:14px;height:14px}
ul.tests li:hover .mgo{opacity:1;transform:none}
.also{display:flex;flex-wrap:wrap;align-items:center;gap:8px;padding:6px 0 4px}
.also .linkchip{background:var(--line-2);font-size:13.5px;padding:5px 12px}
.also .linkchip.solid{background:var(--dpurple);color:#fff;display:inline-flex;align-items:center;gap:6px}
.also .linkchip.solid svg{width:14px;height:14px}
.also-t{font-size:13.5px;color:var(--ink-2);font-weight:600;margin:0 2px 0 6px}
.lchip{all:unset;cursor:pointer;background:var(--line-2);border-radius:9px;padding:4px 10px;font-size:13px;font-weight:600;transition:background .2s,color .2s,transform .3s var(--ease)}
.lchip:hover{background:var(--dpurple);color:#fff;transform:translateY(-1px)}
.lchip:focus-visible,.count-link:focus-visible{outline:2.5px solid var(--focus);outline-offset:2px}
.count-link{color:var(--accent);font-weight:700;text-decoration:none;white-space:nowrap}
.count-link:hover{text-decoration:underline}
tr.rowlink{cursor:pointer}
.stat.txt b{font-size:19px;letter-spacing:-.01em;line-height:1.25}
.rel{position:relative;margin-top:16px;display:flex;flex-direction:column;gap:10px}
.rel-row{display:flex;flex-wrap:wrap;align-items:center;gap:8px}
.rel .also-t{margin-left:0;color:var(--ink)}
.rel .lchip{background:var(--surface)}
.bycat+.bycat{margin-top:22px}
.bycat>h3{margin:0 0 12px;font-size:17px;font-weight:800;display:flex;align-items:center;gap:10px}
.bycat>h3 span{font-weight:600;color:var(--ink-3);font-size:14px}
.cdot{width:12px;height:12px;border-radius:50%;flex:none}

.panel.dup{margin-top:14px;background:color-mix(in srgb,var(--yellow) 30%,var(--surface));border-color:color-mix(in srgb,var(--yellow) 70%,var(--line))}
.panel.dup .panel-h .nm small{font-weight:500;line-height:1.45;margin-top:4px}
.panel.dup .tablewrap{background:var(--surface)}
.dup-h{margin:14px 0 10px;font-size:15.5px;font-weight:800}
.pairs{display:flex;flex-direction:column;gap:8px}
.pair{display:flex;flex-wrap:wrap;align-items:center;gap:8px;background:var(--surface);border-radius:12px;padding:8px 12px}
.pair .amp{font-size:13px;color:var(--ink-3)}
.pair-n{margin-left:auto;font-weight:800;font-size:14px}
.panel.dup .lchip{background:var(--line-2)}
.panel.dup .lchip:hover{background:var(--dpurple);color:#fff}

/* ---------- search / markers ---------- */
.res-sec+.res-sec{margin-top:34px}
.res-sec>h2{margin:0 0 14px;font-size:20px;font-weight:800}
.tablewrap{overflow-x:auto;background:var(--surface);border:1.5px solid var(--line);border-radius:20px}
table{border-collapse:collapse;width:100%;font-size:14.5px}
th,td{text-align:left;padding:12px 16px;border-bottom:1px solid var(--line);vertical-align:top}
tr:last-child td{border-bottom:0}
th{font-size:13.5px;color:var(--ink-2);font-weight:700;background:var(--line-2)}
td.nm{font-weight:700;min-width:190px}
tbody tr{transition:background .2s}
tbody tr:hover{background:var(--line-2)}
td .chips .chip{font-size:13px;padding:3px 9px}
.empty{padding:50px 20px;text-align:center;color:var(--ink-2);font-size:16px}
.empty b{display:block;font-size:22px;color:var(--ink);margin-bottom:6px}

@media (max-width:760px){
  .grid,.comp-grid{grid-template-columns:1fr;gap:12px}
  .tile{min-height:140px;padding:20px}
  .tile.big{min-height:170px}
  .t-num{font-size:36px}
  .top-in{padding:12px 16px;gap:10px}
  .search{max-width:none;order:3;flex-basis:100%}
  .tabs{flex:1;order:2}.tabs button{flex:1;padding:8px 6px;font-size:13.5px}
  .brand{order:1;margin-right:0;width:100%;gap:12px}
  .logo{height:36px}
  .brand-sep{height:28px}
  .top{position:static}
  .wrap{padding:6px 16px 60px}
  .steps{display:none}
  .hero{padding:22px 18px}
  ul.tests{grid-template-columns:1fr}ul.tests.al{grid-template-columns:1fr 1fr}
  .panel-h{padding:16px}
  .p-body{padding:4px 16px 18px}
}
@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{animation-duration:.01ms!important;animation-delay:0ms!important;transition-duration:.01ms!important}
}
</style>
</head>
<body>
<header class="top" id="top">
  <div class="top-in">
    <button class="brand" id="home" aria-label="Klea Health, back to all categories">
      <img class="logo" src="data:image/png;base64," width="109" height="44" alt="Klea Health">
      <span class="brand-sep" aria-hidden="true"></span>
