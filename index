  const hasBack=!Q.trim()&&(!!parentOf(route)||hist.length>1);
  backBtn.classList.toggle("gone",!hasBack&&!Q.trim());
  backBtn.setAttribute("aria-label",Q.trim()?"Clear search":"Go back");
  const depth=route.view==="services"?route.depth:null;
  const total=route.svc?(route.svc.sub?4:3):route.sub?4:(route.cat&&subsOf(route.cat).length?4:3);
  stepsEl.innerHTML=depth===null||Q.trim()?"":Array.from({length:Math.max(total,depth+1)},(_,k)=>`<i class="${k<depth?"on":""} ${k===depth?"cur":""}"></i>`).join("");
  document.querySelectorAll(".tabs button").forEach(b=>b.setAttribute("aria-selected",b.dataset.route==="#/"+(route.view==="services"?"":route.view)));
  movePill();
  countUp();
  if(HL){const h=stage.querySelector("li.hit");if(h)setTimeout(()=>h.scrollIntoView({behavior:reduce.matches?"auto":"smooth",block:"center"}),650)}
}
function wait(ms){return new Promise(r=>setTimeout(r,ms))}
async function transition(dir){
  if(busy)return;busy=true;
  if(!reduce.matches&&stage.children.length){
    stage.classList.add("leaving");if(dir==="back")stage.classList.add("dir-back");
    shead.classList.add("leaving");
    if(chosenEl)chosenEl.classList.add("chosen");
    await wait(chosenEl?380:300);
  }
  shead.classList.remove("leaving");
  stage.classList.remove("leaving");
  chosenEl=null;
  window.scrollTo({top:0,behavior:"instant"});
  paint(dir);
  busy=false;
}
function go(h,el){chosenEl=el||null;if(location.hash===h){route=parse(h);transition("fwd")}else location.hash=h}
const hist=[location.hash||"#/"];
window.addEventListener("hashchange",()=>{
  const nr=parse(location.hash);const h=location.hash||"#/";
  const isBack=hist.length>1&&hist[hist.length-2]===h;
  if(isBack)hist.pop();else hist.push(h);
  const dir=isBack?"back":"fwd";
  if(Q.trim()){HL=Q.trim();Q="";qEl.value="";sbox.classList.remove("has")}
  else if(isBack||nr.view!==route.view)HL="";
  route=nr;transition(dir);
});

/* count-up */
function countUp(){
  if(reduce.matches)return;
  document.querySelectorAll("[data-count]").forEach(el=>{
    const end=+el.dataset.count;if(!end||end<3)return;
    const small=el.querySelector("small");const suffix=small?small.outerHTML:"";
    const t0=performance.now(),dur=Math.min(900,420+end*3);
    const step=t=>{const k=Math.min(1,(t-t0)/dur);const e=1-Math.pow(1-k,3);el.innerHTML=Math.round(end*e)+suffix;if(k<1)requestAnimationFrame(step)};
    requestAnimationFrame(step);
  });
}

/* tab pill */
const pill=document.querySelector(".tabs .pill");
function movePill(){const b=document.querySelector('.tabs button[aria-selected="true"]');if(!b)return;pill.style.width=b.offsetWidth+"px";pill.style.transform=`translateX(${b.offsetLeft}px)`}
window.addEventListener("resize",movePill);

/* events */
document.addEventListener("click",e=>{
  const t=e.target.closest("[data-go]");
  if(t){e.preventDefault();go(t.dataset.go,t.classList.contains("tile")?t:null);return}
  const ph=e.target.closest(".panel-h");
  if(ph){const p=ph.closest(".panel");const o=p.classList.toggle("open");ph.setAttribute("aria-expanded",o);return}
  if(e.target.id==="hloff"){HL="";paint("fwd")}
});
document.querySelectorAll(".tabs button").forEach(b=>b.addEventListener("click",()=>{Q="";qEl.value="";sbox.classList.remove("has");HL="";go(b.dataset.route)}));
document.getElementById("home").onclick=()=>{Q="";qEl.value="";sbox.classList.remove("has");HL="";go("#/")};
backBtn.onclick=()=>{
  if(Q.trim()){Q="";qEl.value="";sbox.classList.remove("has");transition("back");return}
  goBack();
};
function goBack(){if(hist.length>1)history.back();else{const p=parentOf(route);if(p)go(p)}}
const qEl=document.getElementById("q"),sbox=document.getElementById("sbox");let tmr;
qEl.addEventListener("input",()=>{clearTimeout(tmr);tmr=setTimeout(()=>{const was=!!Q.trim();Q=qEl.value;sbox.classList.toggle("has",!!Q);
  if(was&&Q.trim()){busy=false;paint("fwd");return}transition(Q.trim()?"fwd":"back")},180)});
document.getElementById("clr").onclick=()=>{qEl.value="";Q="";sbox.classList.remove("has");transition("back");qEl.focus()};
document.addEventListener("keydown",e=>{
  if(e.key==="/"&&document.activeElement!==qEl){e.preventDefault();qEl.focus()}
  if(e.key==="Escape"){if(document.activeElement===qEl&&Q){document.getElementById("clr").click()}else if(!Q){goBack()}}
});
const topEl=document.getElementById("top");addEventListener("scroll",()=>topEl.classList.toggle("scrolled",scrollY>4),{passive:true});
if(document.fonts&&document.fonts.ready)document.fonts.ready.then(movePill);
paint("fwd");
})();
</script>
</body>
